# Proveedor de modelo de lenguaje. Soportados: openai | anthropic | mock
# El ciclo del agente y las herramientas NO dependen del proveedor.
LLM_PROVIDER=mock

# Clave del proveedor. NUNCA se versiona ni se expone en el front o los logs.
# Para openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Para anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Puerto del backend
PORT=3001

# Topes de costo
MAX_ITERATIONS=25
MAX_TOKENS_PER_SESSION=200000

# Fecha de referencia para evaluar vigencia de soportes (determinismo en la demo)
FECHA_EJECUCION=2026-09-03
